# Environment Variables for Velmora Spark

# ── Primary Database ────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or standard Postgres)
DATABASE_URL=postgresql://user:password@localhost:5432/velmora_spark

# ── Test Database (Required for live DB integration tests) ───────────────────
# Dedicated disposable database URL for integration tests.
# Safety invariant: Integration tests NEVER target the primary DATABASE_URL.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/velmora_spark_test

# ── Authentication & Token Derivation ────────────────────────────────────────
# Server-side cryptographic secret used for organizer HMAC token derivation.
# MUST be at least 32 characters long. Never expose to client.
# Generate with: openssl rand -hex 32
AUTH_SECRET=your_cryptographically_strong_random_secret_at_least_32_chars_here

# ── Gemini AI (server-side only — never expose to client) ────────────────────
# Get your API key: https://aistudio.google.com/app/apikey
# Without this key, the app runs with deterministic fallback suggestions.
GEMINI_API_KEY=your_gemini_api_key_here
